# ═══════════════════════════════════════════════════════════════
# HEIKEN — PRODUCTION ENV (engine on your laptop/VPS)
# Used by: node server/index.js with NODE_ENV=production.
# Copy the values you need into your shell / systemd / PM2.
# ═══════════════════════════════════════════════════════════════

SERVER_PORT=3000
SERVER_HOST=0.0.0.0
SERVER_PROTOCOL=https          # tunnel handles TLS, so this is cosmetic here

# ── Auth — CHANGE THESE ─────────────────────────────────────────
ADMIN_PASSWORD=change-me
REQUIRE_AUTH=true
SESSION_TTL_DAYS=7
DEFAULT_TICKET_DAYS=30

# ── Split hosting ───────────────────────────────────────────────
# The static UI origin (Netlify). Leave blank if UI is served from the same
# box (npm start) — then nothing here is needed.
FRONTEND_URL=https://your-app.netlify.app

# ── Tunnel (ngrok auto-start with npm start) ───────────────────
# Free static domain from https://dashboard.ngrok.com → Domains → New Domain:
# NGROK_URL=https://heiken.ngrok-free.app
# AUTO_TUNNEL=0   # set to disable auto-ngrok

# ── Resource budget for a laptop / small VPS (5 viewers) ────────
LITE_MODE=true
DISABLE_TRANSCODE=true
MAX_ACTIVE_TORRENTS=5
MAX_STREAM_RESPONSES=12
BROWSE_CACHE_MIN=30

# ── Optional metadata keys ──────────────────────────────────────
# TMDB: prefer the API Read Access Token (Bearer) — the v3 `api_key`
# query method 401s for token-only accounts. Set one of:
# TMDB_ACCESS_TOKEN=
# TMDB_API_KEY=
# OMDb (optional): https://www.omdbapi.com/apikey.aspx
# OMDB_API_KEY=

NODE_ENV=production
