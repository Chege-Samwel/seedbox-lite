# ═══════════════════════════════════════════════════════════════
# HEIKEN CLIENT — ENV TEMPLATE (used by `vite build` in client/)
# Copy to client/.env (or set the same vars in Netlify's dashboard) and
# rebuild the static site.
# ═══════════════════════════════════════════════════════════════

# The PUBLIC https URL of the Heiken SERVER (the laptop/VPS behind the
# tunnel) that this static UI talks to.
#   - Same box / npm start:  leave EMPTY  (UI+API share one origin)
#   - Split hosting (Netlify UI + engine at home):
#       VITE_API_BASE_URL=https://seedbox.your-domain.com
#   - Quick tunnel (URL changes every run): leave EMPTY and type the
#     current URL into the "Server address" box on the login screen.
VITE_API_BASE_URL=

# App name/version shown in the UI and installable-PWA metadata.
VITE_APP_NAME=Heiken
VITE_APP_VERSION=1.0.0

# PWA install prompt ("Add to Home screen" on phones / Android TV).
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false
