# ═══════════════════════════════════════════════════════════════
# HEIKEN CLIENT — PRODUCTION ENV (Netlify static UI)
# vite build reads this file. You can also set these as env vars in the
# Netlify dashboard (Site configuration → Environment variables) — those
# override this file.
# ═══════════════════════════════════════════════════════════════

# The PUBLIC https URL of the Heiken SERVER (engine on your laptop/VPS).
#   - Split hosting (Netlify UI + engine at home): the tunnel URL, e.g.
#       VITE_API_BASE_URL=https://seedbox.your-domain.com
#   - Quick tunnel (URL changes every run): leave EMPTY, then type the
#     current URL into the "Server address" box on the login screen once.
#     (It's remembered on that device — no rebuild needed.)
VITE_API_BASE_URL=

# App name/version (also feeds the PWA install metadata).
VITE_APP_NAME=Heiken
VITE_APP_VERSION=1.0.0

# PWA install prompt ("Add to Home screen").
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false
