# Production Environment Variables for the CLIENT build (vite build reads this file!)
#
# VITE_API_BASE_URL — leave EMPTY for the normal setup (npm start serves
# UI+API from one origin — nothing to configure).
#
# Set it ONLY when the API genuinely lives on another origin (split hosting:
# static UI on Netlify/Render, engine at home behind a tunnel) — and then it
# must be the REAL public https URL of the server, e.g.
#   VITE_API_BASE_URL=https://seedbox.your-tunnel-domain.example
#
# WARNING: a wrong value here (or the old `https://seedbox-api.<domain>`
# placeholder) breaks EVERY API call — the symptom is the login screen
# saying "Cannot reach the server at all". The app now self-heals by
# falling back to same-origin when the baked URL is unreachable, but set it
# correctly regardless.
VITE_API_BASE_URL=

# App configuration
VITE_APP_NAME=SeedBox Lite
VITE_APP_VERSION=1.0.0

# Feature flags
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false
