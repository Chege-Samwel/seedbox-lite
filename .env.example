# ===========================================
# SEEDBOX LITE ENVIRONMENT CONFIGURATION
# ===========================================

# ===== SERVER CONFIGURATION =====
# Backend server configuration
SERVER_PORT=3000
SERVER_HOST=localhost
SERVER_PROTOCOL=http

# Backend API base URL (used by frontend)
# For development: http://localhost:3000
# For production: https://your-domain.com
VITE_API_BASE_URL=http://localhost:3000

# ===== CORS CONFIGURATION =====
# Frontend URL for CORS (used by backend)
# For development: http://localhost:5173
# For production: https://your-frontend-domain.com
FRONTEND_URL=http://localhost:5173

# ===== EXTERNAL SERVICES =====
# OpenSubtitles API configuration
OPENSUBTITLES_API_URL=https://rest.opensubtitles.org
SUBTITLE_SEEKER_API_URL=https://api.subtitleseeker.com

# ===== DEVELOPMENT/PRODUCTION =====
# Environment mode
NODE_ENV=development

# ===== TICKETS / AUTH (new streaming suite) =====
# Master admin key for the /admin ticket management area (create, renew,
# discontinue user login tickets). CHANGE THIS IN PRODUCTION.
ADMIN_PASSWORD=admin123

# Require a valid ticket session for the torrent streaming API (true/false).
REQUIRE_AUTH=true

# How long a login session stays valid (days, rolling renewal while used).
SESSION_TTL_DAYS=7

# Default validity of newly created tickets (days; 0 = never expires).
DEFAULT_TICKET_DAYS=30

# Where tickets/sessions/user data are persisted.
# DATA_DIR=./server/data

# ===== RESOURCE BUDGET — LITE_MODE & knobs (see DEPLOYMENT.md) =====
# LITE_MODE=true packs a known-good profile for tiny hosts (512MB container,
# shared CPU, a laptop that should stay quiet/cool). Every value below can
# still be overridden individually; explicit env vars always win.
#
# Lite profile: conns 30 · window -2m/+3m · retain 2m · reap 6m · RSS 420MB ·
# warm 16MB/ready 4MB · keep 2m · max 2 torrents · transcode OFF ·
# browse cache 30m · stream setup timeout 45s.
# LITE_MODE=false

# WebTorrent networking
# WT_MAX_CONNS=150            # lite: 30
# WT_MAX_WEB_CONNS=20         # lite: 8

# Capacity / resilience
# MAX_ACTIVE_TORRENTS=0       # 0 = unlimited; lite: 2 (new loads get HTTP 429)
# MAX_STREAM_RESPONSES=24     # concurrent live streams; lite: 12; excess → fast 503
# STREAM_SETUP_TIMEOUT_MS=60000  # lite: 45000; player auto-reconnects on 503
# BROWSE_CACHE_MIN=10         # home-feed cache; lite: 30
# DISABLE_TRANSCODE=false     # hard kill-switch for ffmpeg (lite: implied)
# WARM_STALL_MS=45000         # no byte progress this long ⇒ swarm reported stalled

# ===== SWARM GUARD (poisoned/fake swarm protection) =====
# A swarm feeding garbage pieces at speed otherwise pegs the CPU on
# hash-verify-discard churn until the WHOLE server stops answering.
# GUARD_TICK_MS=15000         # sample window
# GUARD_TRICKLE_KBPS=96       # throughput while a poisoned torrent is throttled

# ===== MEMORY GOVERNOR (streaming buffer window) =====
# Sliding time-window buffer: keeps ~WINDOW_BACK_MIN behind and
# ~WINDOW_AHEAD_MIN ahead of the playhead; on seek, the previous region is
# retained for LAST_REGION_KEEP_MIN, then dropped. Torrents idle for
# IDLE_TORRENT_TTL_MIN are reaped, and RSS is hard-capped at MAX_RSS_MB
# (the governor sheds idle torrents before the kernel can OOM-kill us).
# WINDOW_BACK_MIN=5
# WINDOW_AHEAD_MIN=5
# LAST_REGION_KEEP_MIN=4
# IDLE_TORRENT_TTL_MIN=10
# MAX_RSS_MB=1400

# ===== PLAY-CLICK WARMUP ("load the starting 1 minute, then play") =====
# Nothing downloads when a magnet is added. When the user presses Play (or
# seeks / "goes to a time"), the server buffers ~1 minute of media FROM THAT
# POSITION and the player starts as soon as the ready-gate is filled.
# WARM_DEFAULT_MB=32     # fallback window size before media duration is known
# WARM_MAX_MB=128        # absolute ceiling per warmup window
# WARM_READY_MIN_MB=8    # "ready" as soon as this much contiguous data is buffered
# WARM_WINDOW_KEEP_MIN=4 # unused warmup windows are deselected after this

# ===== TRANSCODE (quality variants: 1080p/720p/480p/360p from one source) =====
# Requires ffmpeg — system (sudo apt install ffmpeg) or the bundled
# ffmpeg-static optional dependency. Also makes MKV/AVI/HEVC playable.
# TRANSCODE_DEFAULT=720p        # default rendition in "Auto"
# TRANSCODE_PRESET=veryfast     # ultrafast = least CPU, veryfast = smaller; dual-core laptops: keep veryfast
# TRANSCODE_MAX_SESSIONS=2      # concurrent ffmpeg processes (CPU guard)
# TRANSCODE_IDLE_MS=300000      # kill transcodes idle this long

# ===== ROLLING DISK STORE (chunks on disk, not RAM) =====
# Pieces are stored on server disk in a capped rolling window and the oldest
# chunks behind the playhead are auto-evicted — only ~3 min of media ever
# lives in RAM. Directories are wiped when a torrent is removed and the whole
# store is cleaned on every server boot.
# STORE_DIR=./server/data/chunks
# STORE_CAP_MB=800        # per-torrent ceiling until governor tunes it by bitrate
# DISK_CAP_MB=12000       # global safety across all torrents

# ===== METADATA / PICTURE LIBRARY =====
# Optional: richer artwork + TV data from TMDB (get a free key at
# https://www.themoviedb.org/settings/api). Without it, the app falls back
# to TVMaze + iTunes + OMDb.
# TMDB_API_KEY=your_tmdb_key_here
# OMDb: the BUNDLED public demo key is rate-limited/dead (you'll see
# "OMDb lookup failed: HTTP 401" in the log). Get your own free key at
# https://www.omdbapi.com/apikey.aspx and put it here:
# OMDB_API_KEY=your_omdb_key_here

# ===== EXAMPLE CONFIGURATIONS =====
# 
# === LOCAL DEVELOPMENT ===
# SERVER_PORT=3000
# SERVER_HOST=localhost
# SERVER_PROTOCOL=http
# VITE_API_BASE_URL=http://localhost:3000
# FRONTEND_URL=http://localhost:5173
# 
# === DOCKER DEVELOPMENT ===
# SERVER_PORT=3000
# SERVER_HOST=0.0.0.0
# SERVER_PROTOCOL=http
# VITE_API_BASE_URL=http://localhost:3000
# FRONTEND_URL=http://localhost:5173
# 
# === PRODUCTION DEPLOYMENT ===
# SERVER_PORT=3000
# SERVER_HOST=0.0.0.0
# SERVER_PROTOCOL=https
# VITE_API_BASE_URL=https://api.yourdomain.com
# FRONTEND_URL=https://yourdomain.com
# 
# === CUSTOM NETWORK ===
# SERVER_PORT=8080
# SERVER_HOST=192.168.1.100
# SERVER_PROTOCOL=http
# VITE_API_BASE_URL=http://192.168.1.100:8080
# FRONTEND_URL=http://192.168.1.200:3000
