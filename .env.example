# ═══════════════════════════════════════════════════════════════
# HEIKEN — ENVIRONMENT TEMPLATE
# Copy to `.env` (server side) and fill in the blanks.
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── Server (used by `node server/index.js` / `npm start`) ───────
SERVER_PORT=3000            # one port for UI + API + streaming
SERVER_HOST=0.0.0.0         # 0.0.0.0 = reachable from other devices/tunnels
SERVER_PROTOCOL=http        # https only if you terminate TLS yourself

# ── Auth ────────────────────────────────────────────────────────
# Master admin key for /admin ticket management. CHANGE THIS.
ADMIN_PASSWORD=change-me
# Require a ticket session for the streaming API (true/false)
REQUIRE_AUTH=true
# Login session lifetime (days; rolling renewal while used)
SESSION_TTL_DAYS=7
# Default validity of new tickets (days; 0 = never expires)
DEFAULT_TICKET_DAYS=30

# ── Split hosting (static UI on Netlify + engine here) ─────────
# The PUBLIC https URL of THIS server as seen from the browser.
# With Cloudflare Tunnel: https://seedbox.your-domain.com
# (Quick tunnels change every run — leave this blank and instead type the
#  current URL into the "Server address" box on the login screen once.)
VITE_API_BASE_URL=
# The origin that serves the static UI (Netlify URL). CORS allow-list.
FRONTEND_URL=https://your-app.netlify.app

# ── Resource budget (laptop-friendly defaults) ──────────────────
# LITE_MODE=true packs a cool profile: fewer connections, smaller buffer
# windows, RSS cap ~420MB, transcode OFF, max 2 torrents.
LITE_MODE=true
# Hard kill-switch for ffmpeg transcoding (biggest CPU/heat source).
DISABLE_TRANSCODE=true
# Concurrent torrents loaded at once — raise to match expected viewers
# (e.g. 5 for ~5 connections). New loads beyond the cap get HTTP 429.
MAX_ACTIVE_TORRENTS=5
# Optional individual knobs (defaults shown):
# WT_MAX_CONNS=30            # WebTorrent peer connections
# MAX_STREAM_RESPONSES=12    # concurrent live streams; excess → fast 503
# MAX_RSS_MB=420             # hard memory ceiling
# BROWSE_CACHE_MIN=30        # home-feed cache minutes

# ── Metadata / artwork (optional) ───────────────────────────────
# Get a free key at https://www.themoviedb.org/settings/api
# TMDB_API_KEY=your_tmdb_key_here
# Get a free key at https://www.omdbapi.com/apikey.aspx
# OMDB_API_KEY=your_omdb_key_here

# ── Environment ─────────────────────────────────────────────────
NODE_ENV=development        # 'development' or 'production'
