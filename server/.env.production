# ═══════════════════════════════════════════════════════════════
# HEIKEN SERVER — PRODUCTION ENV TEMPLATE
# This file lives at server/.env.production and is read by the server
# process (dotenv). Copy to server/.env when running in production, or set
# these same variables in your hosting dashboard (PM2 / systemd / Docker).
# ═══════════════════════════════════════════════════════════════

SERVER_PORT=3000
SERVER_HOST=0.0.0.0
SERVER_PROTOCOL=http

# ── Auth — CHANGE THESE ─────────────────────────────────────────
ADMIN_PASSWORD=change-me
REQUIRE_AUTH=true
SESSION_TTL_DAYS=7
DEFAULT_TICKET_DAYS=30

# ── Split hosting (static UI on Netlify/Render + engine here) ───
# The origin that serves the static UI — added to the CORS allow-list.
FRONTEND_URL=https://your-app.netlify.app
# If you have a stable public URL for THIS server (named tunnel/domain),
# you can bake it into the UI instead of typing it on the login screen:
# VITE_API_BASE_URL=https://seedbox.your-domain.com

# ── Resource budget — laptop / small VPS (≈5 viewers) ───────────
LITE_MODE=true
DISABLE_TRANSCODE=true
MAX_ACTIVE_TORRENTS=5
# MAX_STREAM_RESPONSES=12
# MAX_RSS_MB=420
# BROWSE_CACHE_MIN=30

# ── Optional metadata keys (better artwork) ─────────────────────
# TMDB_API_KEY=
# OMDB_API_KEY=

NODE_ENV=production
